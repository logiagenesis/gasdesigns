# ---------------------------------------------------------------------------
# Gas Designs — environment configuration
#
# Copy to .env.local for development, and set the same keys in your hosting
# provider's dashboard for production. Never commit a filled-in .env.local.
#
# Everything here is optional: the site builds and runs with all of it blank.
# What each blank value costs you is noted below.
# ---------------------------------------------------------------------------

# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph
# tags, the sitemap and robots.txt. Set this per environment.
NEXT_PUBLIC_SITE_URL=https://www.gasdesigns.co.za


# --- Analytics -------------------------------------------------------------
# GTM is preferred. If NEXT_PUBLIC_GTM_ID is set, GA4 is NOT loaded directly —
# configure the GA4 tag inside Tag Manager instead. Blank means no analytics
# script loads at all, and the privacy policy adjusts itself accordingly.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=


# --- Lead delivery (required for the enquiry form to work) ------------------
# Plain authenticated SMTP into the Google Workspace inbox. No Gmail API, no
# service account. With Workspace, SMTP_USER is the mailbox address and
# SMTP_PASS must be an App Password, not the account password.
#
# While these are blank the form returns a clear error to the visitor and logs
# a server-side warning — it never silently swallows a lead.
CONTACT_TO_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be an address the SMTP account is allowed to send as.
SMTP_FROM=


# --- Public contact details ------------------------------------------------
# PENDING CLIENT CONFIRMATION.
#
# The live maintenance page shows +27 61 039 7034, but the same number is
# published by DP Energies. Until the client confirms the number is theirs
# alone, leave these blank: click-to-call, the WhatsApp link, the mobile
# contact bar and LocalBusiness schema all stay switched off, and the site
# falls back to email. Do not fill these in on the client's behalf.
#
# NEXT_PUBLIC_BUSINESS_PHONE=+27 61 039 7034      # display format
# NEXT_PUBLIC_WHATSAPP_NUMBER=27610397034         # E.164 digits, no + or spaces
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Overrides the confirmed default of pierre@gasdesigns.co.za.
NEXT_PUBLIC_BUSINESS_EMAIL=


# --- Location and coverage -------------------------------------------------
# PENDING CLIENT CONFIRMATION. LocalBusiness structured data is only emitted
# once BOTH a phone number and an area served are set — an empty-NAP
# LocalBusiness entry is worse for search than emitting none at all.
NEXT_PUBLIC_ADDRESS_STREET=
NEXT_PUBLIC_ADDRESS_LOCALITY=
NEXT_PUBLIC_ADDRESS_REGION=
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=

# Comma-separated, e.g. "Pretoria,Centurion,Midrand"
NEXT_PUBLIC_AREA_SERVED=

# Schema.org openingHours format, e.g. "Mo-Fr 07:00-17:00".
# Do NOT set this to a 24/7 value until the client confirms it in writing —
# the 24/7 line in the original brief came from DP Energies' website.
NEXT_PUBLIC_OPENING_HOURS=

# Google Business Profile / Maps link, once the profile exists.
NEXT_PUBLIC_GOOGLE_MAPS_URL=
